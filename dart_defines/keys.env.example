# dart_defines/keys.env 파일을 이 파일 기반으로 만드세요.
# 실제 키 값을 채운 뒤 keys.env로 저장 (절대 커밋 금지)
#
# 빌드/실행:
#   flutter run --dart-define-from-file=dart_defines/keys.env
#   flutter build apk --release --dart-define-from-file=dart_defines/keys.env

KAKAO_APP_KEY=your_kakao_native_app_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_DIRECTIONS_API_KEY=your_google_directions_api_key_here
